{
  "name": "cradle-server",
  "version": "1.0.0",
  "description": "Software Life Engineering Platform",
  "engines": {
    "node": ">=22 <23"
  },
  "type": "module",
  "main": "src/cradle.js",
  "bin": {
    "cradle": "./src/cradle.js",
    "cradle-api": "./src/cradle-api.js"
  },
  "scripts": {
    "copilot:ensure": "node scripts/ensure-copilot-cli.js",
    "benchmark:artifact": "node --expose-gc scripts/benchmark-artifact-performance.js",
    "benchmark:llm": "node scripts/benchmark-llm-scheduling.js",
    "test": "node scripts/run-tests.js",
    "start": "node src/cradle.js start",
    "dev": "node src/cradle.js start",
    "api": "node src/cradle-api.js"
  },
  "keywords": [
    "cradle",
    "dna-driven-design",
    "software-life-engineering",
    "ai",
    "copilot"
  ],
  "author": "Alan Huang",
  "license": "MIT",
  "dependencies": {
    "@github/copilot-sdk": "^0.3.0",
    "@google/genai": "^2.11.0",
    "dotenv": "^17.4.2",
    "pdfjs-dist": "^6.3.289",
    "terminal-kit": "^3.1.2",
    "ws": "^8.18.0"
  }
}
